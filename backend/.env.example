# Application
APP_NAME=One Ummah API
APP_VERSION=1.0.0
DEBUG=False

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oneummah
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/oneummah

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Credentials (Pre-configured, cannot be registered)
ADMIN_EMAIL=admin@oneummah.org
ADMIN_PASSWORD=Admin@2024!Secure

# CORS Origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
